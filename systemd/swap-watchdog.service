[Unit]
Description=Swap/memory-pressure watchdog that reveals Force Quit Monitor when critical
After=graphical-session.target force-quit-gui.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Code/swap-watchdog/bin/swap-watchdog
Restart=always
RestartSec=5
OOMScoreAdjust=-1000

[Install]
WantedBy=graphical-session.target
